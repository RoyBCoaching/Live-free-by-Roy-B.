<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Digital Liberty - A5 Flyer (Voor & Achter)</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #0b1329;
            --primary-light: #16244f;
            --gold: #c5a880;
            --gold-bright: #dfbe8f;
            --gold-soft: #f5efe6;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --bg-light: #f8fafc;
            --white: #ffffff;
            --green: #25d366;
        }

        @page {
            size: A5 portrait;
            margin: 0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 40px;
            padding: 40px 0;
        }

        /* A5 Afmetingen: 148mm x 210mm */
        .flyer-page {
            width: 148mm;
            height: 210mm;
            position: relative;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0,0,0,0.25);
            page-break-after: always;
        }

        /* =========================================
           VOORKANT (Donker marineblauw met goud)
           ========================================= */
        .flyer-front {
            background-color: var(--primary);
            color: var(--white);
            padding: 10mm 10mm 8mm 10mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
            border: 2mm solid var(--gold);
        }

        .front-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .logo-svg {
            width: 38px;
            height: 38px;
        }

        .logo-title {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--white);
        }

        .logo-sub {
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold-bright);
        }

        .front-hero h1 {
            font-size: 24px;
            font-weight: 800;
            line-height: 1.2;
            margin-top: 6px;
        }

        .front-hero .gold {
            color: var(--gold-bright);
        }

        .front-hero .white {
            color: var(--white);
        }

        .front-desc {
            font-size: 9.5px;
            color: #cbd5e1;
            font-weight: 300;
            line-height: 1.5;
            margin-top: 6px;
        }

        /* Foto & Quote */
        .front-profile {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 6px 0;
        }

        .photo-ring {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            border: 2.5px solid var(--gold-bright);
            box-shadow: 0 0 20px rgba(223, 190, 143, 0.3);
            overflow: hidden;
            margin-bottom: 6px;
        }

        .photo-ring img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-badge {
            font-size: 7.5px;
            font-weight: 700;
            color: var(--gold-bright);
            letter-spacing: 1px;
            text-transform: uppercase;
            border: 1px solid var(--gold);
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(197, 168, 128, 0.1);
        }

        .profile-quote {
            font-size: 9.5px;
            font-style: italic;
            color: var(--white);
            line-height: 1.5;
            margin-top: 8px;
            padding: 0 6mm;
        }

        /* Vinkjes */
        .front-features {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(197, 168, 128, 0.3);
            border-radius: 6px;
            padding: 6px 10px;
            text-align: left;
            margin: 4px 0;
        }

        .front-features ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .front-features li {
            font-size: 8.5px;
            color: #e2e8f0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .front-features li i {
            color: var(--gold-bright);
            font-size: 9px;
        }

        /* Contactcta */
        .front-cta {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }

        .front-btn {
            background: var(--gold-bright);
            color: var(--primary);
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            padding: 9px 24px;
            border-radius: 4px;
            letter-spacing: 0.5px;
            width: 100%;
            max-width: 90%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .front-subtext {
            font-size: 7.5px;
            color: var(--gold);
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        /* =========================================
           ACHTERKANT (Helder Off-White & Symmetrisch)
           ========================================= */
        .flyer-back {
            background-color: var(--white);
            color: var(--text-dark);
            padding: 9mm 9mm 7mm 9mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid #cbd5e1;
        }

        .back-title-block {
            text-align: center;
            border-bottom: 2px solid var(--gold-soft);
            padding-bottom: 5px;
        }

        .back-title-block h2 {
            font-size: 15px;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .back-title-block .subtitle {
            font-size: 9px;
            color: var(--gold);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Tweeluik */
        .two-ways-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin: 6px 0;
        }

        .way-box {
            background: var(--bg-light);
            border: 1px solid #e2e8f0;
            border-top: 2.5px solid var(--gold);
            border-radius: 4px;
            padding: 8px 10px;
        }

        .way-header {
            margin-bottom: 6px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
        }

        .way-name {
            font-size: 9.5px;
            font-weight: 800;
            color: var(--primary);
            display: block;
        }

        .way-tag {
            font-size: 7.5px;
            font-weight: 600;
            color: var(--gold);
            display: block;
        }

        .way-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .way-list li {
            font-size: 7.8px;
            color: #334155;
            display: flex;
            align-items: center;
            gap: 5px;
            line-height: 1.35;
        }

        .way-list li::before {
            content: "•";
            color: var(--gold);
            font-size: 11px;
            line-height: 0;
        }

        /* Yvonne Verhaal */
        .story-box {
            background: #faf8f5;
            border-left: 3px solid var(--gold);
            padding: 7px 10px;
            border-radius: 3px;
            margin: 4px 0;
        }

        .story-box strong {
            font-size: 8.5px;
            color: var(--primary);
            display: block;
            margin-bottom: 3px;
        }

        .story-box p {
            font-size: 7.5px;
            font-style: italic;
            color: #475569;
            line-height: 1.45;
        }

        /* Tarief & Verplaatsing */
        .pricing-box {
            background: var(--bg-light);
            border: 1px solid #e2e8f0;
            border-radius: 5px;
            padding: 8px 12px;
            text-align: center;
        }

        .price-badge {
            font-size: 15px;
            font-weight: 800;
            color: var(--primary);
            line-height: 1;
        }

        .price-sub {
            font-size: 8px;
            color: var(--gold);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 2px;
        }

        .travel-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 6px;
            border-top: 1px solid #e2e8f0;
            padding-top: 4px;
        }

        .travel-table td {
            font-size: 7.2px;
            padding: 2px 4px;
            text-align: left;
        }

        .travel-table td:last-child {
            text-align: right;
            font-weight: 700;
            color: var(--primary);
        }

        .travel-table td.free {
            color: #1e7e34;
        }

        /* Footer Kaart */
        .back-contact {
            background: var(--primary);
            color: var(--white);
            border-radius: 4px;
            padding: 8px;
            text-align: center;
        }

        .back-contact h3 {
            font-size: 9.5px;
            color: var(--gold-bright);
            letter-spacing: 0.5px;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .back-contact .phone {
            font-size: 14px;
            font-weight: 800;
            color: var(--white);
            letter-spacing: 0.5px;
        }

        .back-contact .meta {
            font-size: 7.2px;
            color: #94a3b8;
            margin-top: 2px;
        }

        @media print {
            body {
                background: none;
                padding: 0;
            }
            .flyer-page {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>

    <!-- VOORKANT -->
    <div class="flyer-page flyer-front">
        <div class="front-header">
            <!-- Officiële SVG Aan/Uit Knop van Digital Liberty -->
            <svg class="logo-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="46" stroke="#c5a880" stroke-width="1.8" stroke-opacity="0.3"/>
                <path d="M 33.6 28.5 A 28 28 0 1 0 66.4 28.5" stroke="#dfbe8f" stroke-width="7.5" stroke-linecap="round"/>
